<header class="bg-white border-b border-gray-100 sticky top-0 z-50 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 gap-4">

            <div class="flex items-center gap-8">
                <a href="/" class="flex items-center gap-2">
                    <span class="text-xl font-black tracking-tight text-indigo-600">لوگو‌سایت</span>
                </a>

                <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-gray-600">
                    <a href="/" class="hover:text-indigo-600 transition-colors">صفحه اصلی</a>
                    <a href="#" class="hover:text-indigo-600 transition-colors">محصولات</a>
                    <a href="#" class="hover:text-indigo-600 transition-colors">درباره ما</a>
                </nav>
            </div>

            <div class="flex-1 max-w-md mx-4 hidden sm:block">
                <form action="/search" method="GET" class="relative">
                    <input type="text" name="q" placeholder="جستجو در بین مقالات و محصولات..."
                        class="w-full bg-gray-50 text-gray-900 placeholder-gray-400 text-sm rounded-xl pl-4 pr-10 py-2 border border-gray-200 focus:outline-none focus:border-indigo-500 focus:bg-white transition-all">
                    <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-gray-400">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </div>
                </form>
            </div>
            <% if(!user) {%>
                <div class="flex items-center gap-3">
                    <a href="/login"
                        class="text-sm font-medium text-gray-700 hover:text-indigo-600 px-3 py-2 rounded-xl transition-colors">
                        ورود
                    </a>
                    <a href="/register"
                        class="text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 px-4 py-2 rounded-xl shadow-xs transition-colors">
                        ثبت نام
                    </a>

                    <button type="button" class="md:hidden p-2 text-gray-500 hover:bg-gray-100 rounded-lg">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
                <% } %>
                <% if(user) { %>
                <div class="flex items-center gap-3">

                    <a href="/logout"
                        class="text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 px-4 py-2 rounded-xl shadow-xs transition-colors">
                        خروج
                    </a>
                </div>
                <% } %>

        </div>

        <div class="sm:hidden pb-4">
            <form action="/search" method="GET" class="relative">
                <input type="text" name="q" placeholder="جستجو..."
                    class="w-full bg-gray-50 text-gray-900 placeholder-gray-400 text-sm rounded-xl pl-4 pr-10 py-2 border border-gray-200 focus:outline-none focus:border-indigo-500">
                <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-gray-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </div>
            </form>
        </div>
    </div>
</header>