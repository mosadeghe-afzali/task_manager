<%- include('../partials/head') %>
  <%- include('../partials/navbar') %>

    <main class="flex-1 max-w-2xl w-full mx-auto p-6 sm:p-8 flex items-center justify-center" dir="rtl">
      <div class="w-full bg-white border border-slate-200 rounded-2xl shadow-sm p-6 sm:p-8">

        <div class="mb-6">
          <h1 class="text-xl font-bold text-slate-800">تعریف تیم جدید</h1>
          <p class="text-sm text-slate-500 mt-1">اطلاعات اولیه تیم و اعضای آن را برای شروع همکاری مشخص کنید.</p>
        </div>

        <form action="/teams" method="POST" class="space-y-5">

          <div>
            <label for="teamName" class="block text-sm font-semibold text-slate-700 mb-2">نام تیم *</label>
            <input type="text" id="teamName" name="name"
              value="<%= typeof request !== 'undefined' ? request.name : '' %>" required
              placeholder="مثال: تیم توسعه بک‌اند"
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-500/10 transition-all">
          </div>

          <div>
            <label for="teamSlug" class="block text-sm font-semibold text-slate-700 mb-2">نام مستعار (Slug) *</label>
            <input type="text" id="teamSlug" name="slug"
              value="<%= typeof request !== 'undefined' ? request.slug : '' %>" required
              placeholder="مثال: backend-team" dir="ltr"
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-left text-slate-800 placeholder-slate-400 focus:outline-none focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-500/10 transition-all">
          </div>

          <div>
            <label for="userIds" class="block text-sm font-semibold text-slate-700 mb-2">اعضای تیم *</label>
            <p class="text-xs text-slate-400 mb-2">اعضای مورد نظر خود را جستجو و انتخاب کنید.</p>

            <select id="userIds" name="userIds[]" multiple required class="tom-select w-full">

              <% if (typeof users !=='undefined' && users.length> 0) { %>
                <% users.forEach(function(user) { %>
                  <% let isSelected=false; if (typeof request !=='undefined' && request.userIds) {
                    isSelected=Array.isArray(request.userIds) ? request.userIds.includes(user.id.toString()) :
                    request.userIds==user.id; } %>
                    <option value="<%= user.id %>" <%=isSelected ? 'selected' : '' %>>
                      <%= user.name %> (<%= user.email %>)
                    </option>
                    <% }); %>
                      <% } else { %>
                        <option value="" disabled>کاربری جهت انتخاب یافت نشد</option>
                        <% } %>

            </select>
          </div>

          <% if (typeof errors !=='undefined' && errors.length> 0) { %>
            <div class="mb-6 p-4 bg-red-50 border-r-4 border-red-500 rounded-l-md shadow-sm">
              <div class="flex items-center mb-2">
                <svg class="w-5 h-5 text-red-500 ml-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd"
                    d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                    clip-rule="evenodd"></path>
                </svg>
                <h3 class="text-sm font-semibold text-red-800">لطفاً خطاهای زیر را برطرف کنید:</h3>
              </div>
              <ul class="list-disc list-inside space-y-1">
                <% errors.forEach(function(error) { %>
                  <li class="text-sm text-red-700 font-medium">
                    <%= error.msg %>
                  </li>
                  <% }); %>
              </ul>
            </div>
            <% } %>

              <div class="border-t border-slate-100 pt-4 flex items-center justify-end gap-3">
                <a href="/teams"
                  class="px-4 py-2 rounded-lg text-sm font-medium text-slate-500 hover:bg-slate-100 hover:text-slate-700 transition-colors">
                  انصراف
                </a>

                <button type="submit"
                  class="flex items-center gap-2 py-2 px-5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold transition-all shadow-md shadow-indigo-600/10 hover:shadow-lg hover:shadow-indigo-600/20 active:scale-95">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>ثبت و ایجاد تیم</span>
                </button>
              </div>

        </form>
      </div>
    </main>

    <%- include('../partials/footer') %>

      <script>
        new TomSelect("#userIds", {
          plugins: ['remove_button'],
          placeholder: "اعضای تیم را انتخاب کنید",
          persist: false,
          create: false,
          maxItems: null
        });
      </script>